# Copy to .env and fill in. Never commit .env.

# LiveKit (one project; the same one `chert setup` uses)
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=ody-YOUR_TEAM

# Brain: one of these is enough (Claude is used if both are set; force with ODY_BRAIN=claude|gemini)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ODY_BRAIN=

# Voice
ELEVENLABS_API_KEY=
ELEVEN_VOICE_ID=

# What Ody guides
ODY_TASK=Make the Arduino Uno's onboard LED blink
ODY_EFFORT=low

# Recap over iMessage (optional)
CHERT_API_KEY=
CHERT_PROJECT_ID=
ODY_RECAP_TO=
ODY_PUBLIC_URL=
ODY_SEND_RECAP=0
