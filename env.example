# Copy to .env and fill in. Never commit .env.

# LiveKit (one project; the same one `chert setup` uses)
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGENT_NAME=mentor-YOUR_TEAM

# Brain: one of these is enough (Claude is used if both are set; force with MENTOR_BRAIN=claude|gemini)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MENTOR_BRAIN=

# Voice
ELEVENLABS_API_KEY=
ELEVEN_VOICE_ID=

# What Mentor guides
MENTOR_TASK=Make the Arduino Uno's onboard LED blink
MENTOR_EFFORT=low

# Recap over iMessage (optional)
CHERT_API_KEY=
CHERT_PROJECT_ID=
MENTOR_RECAP_TO=
MENTOR_PUBLIC_URL=
MENTOR_SEND_RECAP=0
