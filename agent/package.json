{
  "name": "ody-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.2 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "start": "node --env-file=../.env agent.mjs start",
    "check": "for f in *.mjs test/*.mjs twin/*.js; do node --check $f || exit 1; done",
    "try-brain": "node --env-file=../.env try-brain.mjs",
    "recaps": "node serve-recaps.mjs",
    "send-recap": "node --env-file=../.env send-recap.mjs",
    "status": "node --env-file=../.env status.mjs",
    "check-keys": "node --env-file=../.env check-keys.mjs",
    "e2e": "node --env-file=../.env test/e2e-video.mjs",
    "dev-agent": "node --env-file=../.env agent.mjs dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.8.0",
    "@google/genai": "^3.3.0",
    "@livekit/agents": "1.8.0",
    "@livekit/agents-plugin-elevenlabs": "1.8.0",
    "@livekit/noise-cancellation-node": "^0.3.0",
    "@livekit/rtc-node": "0.13.35",
    "@mediapipe/tasks-vision": "1.2.0",
    "@napi-rs/canvas": "1.1.1",
    "three": "0.186.1",
    "ws": "^8.23.0"
  },
  "description": "Ody: FaceTime an AI that sees your project and points at it",
  "license": "MIT"
}
